[
  {
    "smyth": "1",
    "donner": "1",
    "donner_opening": "Ihr Kadmosbürger, reden muß das Treffende,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:1-38",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "39",
    "donner": "39",
    "donner_opening": "Eteokles, edler Herrscher im Kadmeiervolk,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:39-77",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "78",
    "donner": "78",
    "donner_opening": "Ich klag' um graunvolles Leid!",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:78-107",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "109",
    "donner": "104",
    "donner_opening": "Schußgötter dieses Landes ihr,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:109-127",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "128",
    "donner": "120",
    "donner_opening": "Tochter Kronions du, Pallas, der Schlachten froh,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:128-148",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "149",
    "donner": "136",
    "donner_opening": "Der Kriegsräder Hall rauscht um die Stadt heran:",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:149-157",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "158",
    "donner": "142",
    "donner_opening": "Hoch an die Zinnen prallt ein Steinregen auf:",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:158-165",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "166",
    "donner": "149",
    "donner_opening": "Gottheiten, allwaltende!",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:166-172",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "174",
    "donner": "156",
    "donner_opening": "O theure Schußgötter, ihr",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:174-180",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "181",
    "donner": "163",
    "donner_opening": "Euch, Weiber, frag' ich, unerträgliches Gezücht,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:181-202",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "203",
    "donner": "184",
    "donner_opening": "O du, des Oedipus theuerer Sohn, mit Graun",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:203-210",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "211",
    "donner": "192",
    "donner_opening": "Hin zu den alten Bildsäulen der Himmlischen",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:211-218",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "219",
    "donner": "200",
    "donner_opening": "Nimmer, so lange mir leuchtet des Lebens Licht,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:219-225",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "226",
    "donner": "207",
    "donner_opening": "Doch weit höher ragt, höher der Götter Macht;",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:226-232",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "233",
    "donner": "214",
    "donner_opening": "Nur mit der Götter Huld bleiben wir unbesiegt,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:233-238",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "239",
    "donner": "220",
    "donner_opening": "Als ich des Kampfes wildtosenden Sturm vernahm,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:239-244",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "245",
    "donner": "226",
    "donner_opening": "Der Rosse wildes Schnauben hör' ich nahe schon.",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:245-287",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "288",
    "donner": "268",
    "donner_opening": "Ich will's; doch Furcht läßt den Geist nimmer ruh'n,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:288-303",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "304",
    "donner": "284",
    "donner_opening": "In welches Land könnt ihr zieh'n, schöner, als",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:304-320",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "321",
    "donner": "300",
    "donner_opening": "O Leid, stürzte die ehrwürdige Stadt",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:321-332",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "333",
    "donner": "312",
    "donner_opening": "O Leid, zöge die Braut, eben erblüht,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:333-344",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "345",
    "donner": "324",
    "donner_opening": "Dumpf in den Gassen Aufruhr:",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:345-356",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "357",
    "donner": "336",
    "donner_opening": "Jegliche Frucht des Feldes,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:357-368",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "369",
    "donner": "348",
    "donner_opening": "Seht dort, der Späher, irr' ich nicht, ihr Lieben, bringt",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:369-416",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "417",
    "donner": "396",
    "donner_opening": "Gewährt, Götter, Ihm, der vorkämpft für uns,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:417-421",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "422",
    "donner": "401",
    "donner_opening": "O gäben ihm die Götter, wie du flehst, den Sieg! -",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:422-451",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "452",
    "donner": "431",
    "donner_opening": "Ha, Tod ihm, der uns so zu bedrohen wagt!",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:452-456",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "457",
    "donner": "436",
    "donner_opening": "Nun will ich weiter sagen, wer das nächste Thor",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:457-480",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "481",
    "donner": "460",
    "donner_opening": "Laut fleh' ich: Ihn kränze des Sieges Glück,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:481-485",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "486",
    "donner": "465",
    "donner_opening": "Ein vierter Heerfürst, der am Nachbarthor gebeut",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:486-520",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "521",
    "donner": "496",
    "donner_opening": "Der Stolze dort, der den verhaften Feind",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:521-525",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "526",
    "donner": "501",
    "donner_opening": "So mög' es enden! Höre nun vom Fünften auch,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:526-562",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "563",
    "donner": "538",
    "donner_opening": "Das Wort schneidet mir in's Herz tief hinein,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:563-567",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "568",
    "donner": "543",
    "donner_opening": "Als sechsten Führer nenn' ich ihn, den weisesten,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:568-625",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "626",
    "donner": "601",
    "donner_opening": "Erhört, Götter, uns, erfüllt gnadenvoll,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:626-630",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "631",
    "donner": "606",
    "donner_opening": "Den Lezten dort am legten Thore nenn' ich nun,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:631-685",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "686",
    "donner": "661",
    "donner_opening": "Und du beharrst, o Kind? Daß dich im Zorne doch",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:686-691",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "692",
    "donner": "667",
    "donner_opening": "Wildes Verlangen treibt dich in ergrimmtem Muth",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:692-697",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "698",
    "donner": "673",
    "donner_opening": "Eile doch nicht so sehr! Nicht seig nennt man dich,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:698-704",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "705",
    "donner": "680",
    "donner_opening": "Fliehe den Tod; denn noch steht es in deiner Macht,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:705-711",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "712",
    "donner": "687",
    "donner_opening": "Uns Frauen folge, liebst du gleich die Frauen nicht.",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:712-719",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "720",
    "donner": "695",
    "donner_opening": "Mir graut: die stammtilgende Göttin,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:720-726",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "727",
    "donner": "701",
    "donner_opening": "Die Loose dort würfelt ein Fremdling,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:727-733",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "734",
    "donner": "707",
    "donner_opening": "Wenn Brudermord Beide nun",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:734-741",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "742",
    "donner": "715",
    "donner_opening": "Der schweren Schuld alter Zeit",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:742-749",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "750",
    "donner": "723",
    "donner_opening": "Bethört dann durch die Lust im Unverstand,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:750-757",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "758",
    "donner": "731",
    "donner_opening": "Ein Meer, wälzt er des Leides Flut heran;",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:758-765",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "766",
    "donner": "739",
    "donner_opening": "Denn, ach! jetzt reift der altverhängte Fluch,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:766-771",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "772",
    "donner": "745",
    "donner_opening": "Denn wer ward so von Göttern hochgeehrt,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:772-777",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "778",
    "donner": "751",
    "donner_opening": "Doch kaum sah er ein,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:778-784",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "785",
    "donner": "758",
    "donner_opening": "Und lud bittern Fluch,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:785-791",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "792",
    "donner": "765",
    "donner_opening": "Getrost, o Jungfrau'n, ihr der Mütter süße Lust!",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:792-821",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "822",
    "donner": "794",
    "donner_opening": "O gewaltiger Zeus und o Schirmer der Stadt,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:822-832b",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "833",
    "donner": "804",
    "donner_opening": "Finstrer Fluch, der sich vollendet",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:833-839",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "840",
    "donner": "812",
    "donner_opening": "Nicht verhallte, klar erfüllte",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:840-847",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "848",
    "donner": "820",
    "donner_opening": "Hier naht es sichtbar; offen liegt des Boten Wort:",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:848-874",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "875",
    "donner": "843",
    "donner_opening": "O Graun! Ihr Unsinnigen,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:875-880",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "881",
    "donner": "848",
    "donner_opening": "O Graun, o Graun! Räuber ihr",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:881-887",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "888",
    "donner": "853",
    "donner_opening": "Die Brust links durchbohrten Beide sich -",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:888-899",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "900",
    "donner": "863",
    "donner_opening": "Die Wehklage hallt die Stadt hindurch.",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:900-910",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "911",
    "donner": "874",
    "donner_opening": "Von Stahles Schlag liegen sie getroffen,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:911-921",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "922",
    "donner": "883",
    "donner_opening": "Wohl darf ich anklagen diese Armen;",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:922-932",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "933",
    "donner": "893",
    "donner_opening": "Ja Bruderhand, liebelos zerfleischend, gab",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:933-944",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "945",
    "donner": "905",
    "donner_opening": "Ihr Theil am Leid, welches Zeus verhängte, fiel,",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:945-956",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "957",
    "donner": "917",
    "donner_opening": "Getroffen trafft du!",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:957-965",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "966",
    "donner": "922",
    "donner_opening": "Rasend tobt im Schmerz die Seele.",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:966-979",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "980",
    "donner": "930",
    "donner_opening": "Wehe!",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:980-993",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "994",
    "donner": "940",
    "donner_opening": "Das sahst du hierherkommend schon-",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:994-1010",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "1011",
    "donner": "950",
    "donner_opening": "Ich muß verkünden, was beschließt und was beschloß",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:1011-1031",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "1032",
    "donner": "971",
    "donner_opening": "Und ich erkläre dieses Volks Gewaltigen :",
    "corresp": "urn:cts:greekLit:tlg0085.tlg004.perseus-grc2:1032-1047",
    "basis": "Speech/stanza/clause content comparison; containing-passage alignment."
  },
  {
    "smyth": "1048",
    "donner": "987",
