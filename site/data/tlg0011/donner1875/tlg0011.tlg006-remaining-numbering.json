{
  "[150, 155]": [
    {
      "n": "150u1",
      "text": "Aber sage mir nun, welches Haus er einsam bewohnt,",
      "page": 285,
      "rid": "r212"
    },
    {
      "n": "150u2",
      "text": "Welcher Ort ihn verbirgt.",
      "page": 285,
      "rid": "r213"
    },
    {
      "n": "150u3",
      "text": "Denn wohl thut es noth, daß ich erkundige,",
      "page": 285,
      "rid": "r214"
    }
  ],
  "[205, 210]": [
    {
      "n": "205u1",
      "text": "Sag' an, worauf?",
      "page": 288,
      "rid": "r286"
    },
    {
      "n": "205u1",
      "text": "Auf neuen Rath:",
      "page": 288,
      "rid": "r288"
    },
    {
      "n": "205u2",
      "text": "Denn nicht ferne, bereits ist er am Ort hier;",
      "page": 288,
      "rid": "r289"
    },
    {
      "n": "205u3",
      "text": "Doch er bläst nicht auf der Schalmei,",
      "page": 288,
      "rid": "r290"
    },
    {
      "n": "205u4",
      "text": "Wie, durchweidend das Feld, ein Hirt;",
      "page": 288,
      "rid": "r291"
    },
    {
      "n": "205u5",
      "text": "Nein, er hebt weithallenden Ruf,",
      "page": 288,
      "rid": "r292"
    }
  ],
  "[525, 530]": [
    {
      "n": "525u1",
      "text": "Ein Schiffer deines Schiffes und der Andre fremd;",
      "page": 300,
      "rid": "r676"
    },
    {
      "n": "525u2",
      "text": "Die mögt ihr hören, eh' ihr euch hinein verfügt.",
      "page": 300,
      "rid": "r677"
    },
    {
      "n": "525u3",
      "text": "Der Späher, als Schiffsherr verkleidet. Ein Schiffer.",
      "page": 300,
      "rid": "r678"
    },
    {
      "n": "525u4",
      "text": "O Sohn Achillens, diesem Fahrtgenossen hier,",
      "page": 300,
      "rid": "r681"
    },
    {
      "n": "525u5",
      "text": "Der deines Schiffes Wächter mit zwei andern war,",
      "page": 300,
      "rid": "r682"
    }
  ],
  "[555, 560]": [
    {
      "n": "555u1",
      "text": "Er ging mit Deneus' Enkel einen andern Mann",
      "page": 301,
      "rid": "r718"
    },
    {
      "n": "555u2",
      "text": "Zu suchen, als ich auf die Fahrt von dannen zog.",
      "page": 301,
      "rid": "r719"
    },
    {
      "n": "555u3",
      "text": "Nach welchem Manne fuhr Odysseus selbst hinaus?",
      "page": 302,
      "rid": "r722"
    },
    {
      "n": "555u4",
      "text": "Es war",
      "page": 302,
      "rid": "r723"
    },
    {
      "n": "555u5",
      "text": "vor Allem sage mir, wer dieser Mann",
      "page": 302,
      "rid": "r726"
    }
  ],
  "[575, 580]": [
    {
      "n": "575u1",
      "text": "Ich erwog es lange schon.",
      "page": 302,
      "rid": "r752"
    },
    {
      "n": "575u2",
      "text": "Die Schuld von Allem bleibe dein!",
      "page": 303,
      "rid": "r755"
    },
    {
      "n": "575u2",
      "text": "Sei's: rede nur!",
      "page": 303,
      "rid": "r757"
    },
    {
      "n": "575u3",
      "text": "Nun gut! Nach dem zieh'n Beide, die ich dir genannt,",
      "page": 303,
      "rid": "r759"
    },
    {
      "n": "575u4",
      "text": "Der Sohn des Tydeus und Odysseus' Kraft, hinaus;",
      "page": 303,
      "rid": "r760"
    },
    {
      "n": "575u5",
      "text": "Sie schwuren, ihn zu bringen, sei's mit klugem Wort",
      "page": 303,
      "rid": "r761"
    }
  ],
  "[700, 705]": [
    {
      "n": "700u1",
      "text": "Hob über dem Deta.",
      "page": 308,
      "rid": "r922"
    },
    {
      "n": "700u2",
      "text": "Komm, wenn du willst. Warum verstummst du plözlich so",
      "page": 308,
      "rid": "r926"
    },
    {
      "n": "700u3",
      "text": "Was hält dich also starr und stumm?",
      "page": 308,
      "rid": "r927"
    },
    {
      "n": "700u4",
      "text": "Ohn' allen Grund?",
      "page": 308,
      "rid": "r928"
    },
    {
      "n": "700u5",
      "text": "Ah, ah, ah, ah!",
      "page": 308,
      "rid": "r929"
    }
  ],
  "[705, 710]": [
    {
      "n": "705u1",
      "text": "Gar nichts Arges: geh nur weiter, Sohn!",
      "page": 308,
      "rid": "r934"
    },
    {
      "n": "705u2",
      "text": "Wohl fühlst du Schmerzen, da die Krankheit nahe dringt?",
      "page": 309,
      "rid": "r937"
    },
    {
      "n": "705u3",
      "text": "Nein, wahrlich! Eben, mein' ich, wird mir's leichter schon.",
      "page": 309,
      "rid": "r939"
    },
    {
      "n": "705u4",
      "text": "Ihr Götter, o!",
      "page": 309,
      "rid": "r940"
    },
    {
      "n": "705u5",
      "text": "Was russt du so die Götter tiefausseufzend an?",
      "page": 309,
      "rid": "r941"
    }
  ],
  "[725, 730]": [
    {
      "n": "725u1",
      "text": "Was?",
      "page": 309,
      "rid": "r966"
    },
    {
      "n": "725u1",
      "text": "Nichts weiß ich.",
      "page": 310,
      "rid": "r968"
    },
    {
      "n": "725u1",
      "text": "Sohn, du weißt - Was red' ich noch?",
      "page": 310,
      "rid": "r970"
    },
    {
      "n": "725u2",
      "text": "Wie? Du weißt es nicht? Ach wehe, weh!",
      "page": 310,
      "rid": "r973"
    },
    {
      "n": "725u3",
      "text": "Schwer drückt der Krankheit Bürde dich, Unglücklicher!",
      "page": 310,
      "rid": "r975"
    },
    {
      "n": "725u4",
      "text": "Schwer wahrlich, graunvoll, namenlos: erbarm dich mein!",
      "page": 310,
      "rid": "r977"
    },
    {
      "n": "725u5",
      "text": "Was kann ich thun? Erschrocken, laß nicht ab von mir:",
      "page": 310,
      "rid": "r980"
    }
  ],
  "[825, 830]": [
    {
      "n": "825u1",
      "text": "Fahrwind athmet ja, Fahrwind,",
      "page": 315,
      "rid": "r1130"
    },
    {
      "n": "825u2",
      "text": "Sohn! Hülflos liegt er und augenlos,",
      "page": 315,
      "rid": "r1131"
    },
    {
      "n": "825u3",
      "text": "Der Mann hier, nächtlich im Schlafe gestreckt,",
      "page": 315,
      "rid": "r1132"
    }
  ],
  "[985, 990]": [
    {
      "n": "985u1",
      "text": "Nun denkst du mich gebunden weg von diesem Strand",
      "page": 322,
      "rid": "r1364"
    },
    {
      "n": "985u2",
      "text": "Zu führen, Frevler, wo du mich einst ausgesezt",
      "page": 322,
      "rid": "r1365"
    },
    {
      "n": "985u3",
      "text": "Freundlos, verlassen, fern von Haus, im Leben todt!",
      "page": 322,
      "rid": "r1366"
    },
    {
      "n": "985u4",
      "text": "Weh!",
      "page": 322,
      "rid": "r1367"
    },
    {
      "n": "985u5",
      "text": "Tod dir! Ich flehte dieses oft auf dich herab;",
      "page": 322,
      "rid": "r1368"
    }
  ],
  "[1145, 1150]": [
    {
      "n": "1145u1",
      "text": "Fremdlinge, weh! Fliehet mich nicht!",
      "page": 329,
      "rid": "r1570"
    },
    {
      "n": "1145u2",
      "text": "Welches Geschrei?",
      "page": 329,
      "rid": "r1572"
    },
    {
      "n": "1145u3",
      "text": "Ach, ach, ach, ach! Geschick, o Geschick!",
      "page": 329,
      "rid": "r1574"
    },
    {
      "n": "1145u4",
      "text": "Ich vergeh' in der Qual!",
      "page": 329,
      "rid": "r1575"
    },
    {
      "n": "1145u5",
      "text": "Fuß, o Fuß, was soll ich hinfort",
      "page": 329,
      "rid": "r1576"
    }
  ],
  "[1215, 1220]": [
    {
      "n": "1215u1",
      "text": "Auch mich sollst du gleich",
      "page": 333,
      "rid": "r1697"
    },
    {
      "n": "1215u2",
      "text": "Dasselbe hier thun sehen, und ich zögre nicht.",
      "page": 333,
      "rid": "r1699"
    },
    {
      "n": "1215u3",
      "text": "Doch nein, ich will dich lassen und dem ganzen Heer",
      "page": 333,
      "rid": "r1701"
    },
    {
      "n": "1215u4",
      "text": "Die Sache kundthun: dieses wird dich züchtigen.",
      "page": 333,
      "rid": "r1702"
    },
    {
      "n": "1215u5",
      "text": "Da denkst du weise: wenn du so auch fürder denkst,",
      "page": 333,
      "rid": "r1705"
    }
  ],
  "[1360, 1365]": [
    {
      "n": "1360u1",
      "text": "Denn schon zu viel klang dieser Name meinem Ohr.",
      "page": 340,
      "rid": "r1915"
    },
    {
      "n": "1360u2",
      "text": "Wenn es dir gefällt, so geh'n wir.",
      "page": 340,
      "rid": "r1917"
    },
    {
      "n": "1360u3",
      "text": "Sohn, du sprachst ein edles Wort.",
      "page": 340,
      "rid": "r1919"
    },
    {
      "n": "1360u4",
      "text": "Stüze nun beherzt den Fuß auf.",
      "page": 340,
      "rid": "r1921"
    },
    {
      "n": "1360u5",
      "text": "Wie es meine Kraft vermag.",
      "page": 340,
      "rid": "r1922"
    },
    {
      "n": "1360u6",
      "text": "Aber wie entflieh'n dem Vorwurf unsers Heers?",
      "page": 340,
      "rid": "r1925"
    }
  ],
  "[1365, 1370]": [
    {
      "n": "1365u1",
      "text": "Da sorge nicht.",
      "page": 340,
      "rid": "r1930"
    },
    {
      "n": "1365u2",
      "text": "Dann bin ich zur Seite dir",
      "page": 340,
      "rid": "r1931"
    },
    {
      "n": "1365u3",
      "text": "Welchen Schuz wirst du mir bieten?",
      "page": 340,
      "rid": "r1933"
    },
    {
      "n": "1365u4",
      "text": "Mit Herakles' Pfeilen hier -",
      "page": 340,
      "rid": "r1935"
    },
    {
      "n": "1365u5",
      "text": "Thust du was?",
      "page": 341,
      "rid": "r1939"
    },
    {
      "n": "1365u6",
      "text": "Halt' ich sie ferne!",
      "page": 341,
      "rid": "r1941"
    },
    {
      "n": "1365u7",
      "text": "Küsse noch das Land und geh!,",
      "page": 341,
      "rid": "r1943"
    },
    {
      "n": "1365u8",
      "text": "Nicht ehe, bevor aus unserem Mund",
      "page": 341,
      "rid": "r1947"
    },
    {
      "n": "1365u9",
      "text": "Du die Worte gehört, o Pöas' Sohn!",
      "page": 341,
      "rid": "r1948"
    }
  ]
}