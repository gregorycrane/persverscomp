{
  "[415, 420]": [
    {
      "n": "415u1",
      "text": "Der dir's bezeugte, daß er das von mir gehört?",
      "page": 184,
      "rid": "r552"
    },
    {
      "n": "415u2",
      "text": "Vor vielen Bürgern. Mitten dort auf offnem Markt",
      "page": 185,
      "rid": "r555"
    },
    {
      "n": "415u3",
      "text": "Zu Trachin hört' es vieles Volk aus deinem Mund.",
      "page": 185,
      "rid": "r556"
    }
  ],
  "[850, 855]": [
    {
      "n": "850u1",
      "text": "Wohl hallt es nicht undeutlich, herzzerreißend tönt",
      "page": 201,
      "rid": "r1077"
    },
    {
      "n": "850u2",
      "text": "Wehklage drinnen; neue Noth gebiert das Haus.",
      "page": 201,
      "rid": "r1078"
    },
    {
      "n": "850u3",
      "text": "siehe,",
      "page": 201,
      "rid": "r1079"
    },
    {
      "n": "850u3",
      "text": "Wie dort die Greisin kummervoll mit düstern Brau'n",
      "page": 201,
      "rid": "r1081"
    }
  ],
  "[950, 955]": [
    {
      "n": "950u1",
      "text": "Sie geräuschlos stillen Schritt.",
      "page": 206,
      "rid": "r1223"
    },
    {
      "n": "950u2",
      "text": "Weh! Sprachlos tragen sie dort ihn her!",
      "page": 206,
      "rid": "r1224"
    },
    {
      "n": "950u3",
      "text": "Wie? Soll ich für todt ihn achten,",
      "page": 206,
      "rid": "r1225"
    },
    {
      "n": "950u4",
      "text": "Oder deckt ihn Schlummer?",
      "page": 206,
      "rid": "r1226"
    },
    {
      "n": "950u5",
      "text": "auf einer Bahre dahergetragen. Hyllos (tritt aus dem Hause).",
      "page": 206,
      "rid": "r1228"
    }
  ],
  "[1000, 1005]": [
    {
      "n": "1000u1",
      "text": "Mich befrein von des Lebens Leid?",
      "page": 208,
      "rid": "r1292"
    },
    {
      "n": "1000u2",
      "text": "Sohn des gewaltigen Manns, dies Werk zu bestehen, gebricht es",
      "page": 208,
      "rid": "r1294"
    },
    {
      "n": "1000u3",
      "text": "Mir an rüstiger Kraft: du fass' ihn! Schärfer erspäht auch",
      "page": 208,
      "rid": "r1295"
    },
    {
      "n": "1000u4",
      "text": "Hülfe dein Aug' als ich es vermag.",
      "page": 208,
      "rid": "r1296"
    },
    {
      "n": "1000u5",
      "text": "Schon halt' ich den Vater;",
      "page": 208,
      "rid": "r1298"
    }
  ]
}