{
  "[460, 465]": [
    {
      "n": "460u1",
      "text": "Beiwohnt und ihn ermordet. Und nun geh' hinein,",
      "page": 26,
      "rid": "r609"
    },
    {
      "n": "460u2",
      "text": "Dem nachzusinnen; wenn du mich auf Lügen triffst,",
      "page": 26,
      "rid": "r610"
    },
    {
      "n": "460u3",
      "text": "Dann sage, völlig mangle mir die Seherkunst.",
      "page": 26,
      "rid": "r611"
    },
    {
      "n": "460u4",
      "text": "Der Chor bleibt allein zurück.)",
      "page": 26,
      "rid": "r613"
    },
    {
      "n": "460u5",
      "text": "Wen meint der weissagende Fels von Pytho, wer hat jene",
      "page": 26,
      "rid": "r616"
    }
  ],
  "[620, 625]": [
    {
      "n": "620u1",
      "text": "Und wenn du irrtest? Für mich gewiß.",
      "page": 33,
      "rid": "r836"
    },
    {
      "n": "620u2",
      "text": "Du bist ein Schalk!",
      "page": 33,
      "rid": "r837"
    },
    {
      "n": "620u2",
      "text": "Doch gehorchen mußt du mir.",
      "page": 33,
      "rid": "r839"
    },
    {
      "n": "620u3",
      "text": "Dem ungerechten Herrscher nie!",
      "page": 33,
      "rid": "r841"
    },
    {
      "n": "620u3",
      "text": "Stadt, o Stadt!",
      "page": 34,
      "rid": "r844"
    },
    {
      "n": "620u4",
      "text": "Theilnahme gönnt auch mir die Stadt, nicht dir allein.",
      "page": 34,
      "rid": "r846"
    },
    {
      "n": "620u5",
      "text": "Laßt ab, Gebieter! Ganz gelegen seh' ich euch",
      "page": 34,
      "rid": "r848"
    }
  ],
  "[670, 675]": [
    {
      "n": "670u1",
      "text": "Freilich.",
      "page": 36,
      "rid": "r926"
    },
    {
      "n": "670u2",
      "text": "Und wie kam es so?",
      "page": 36,
      "rid": "r928"
    },
    {
      "n": "670u3",
      "text": "Sei es genug, genug bei der gemeinen Noth!",
      "page": 36,
      "rid": "r930"
    },
    {
      "n": "670u4",
      "text": "Ruhe der Hader dort, wo er sein Ende fand!",
      "page": 36,
      "rid": "r931"
    },
    {
      "n": "670u5",
      "text": "Sieh, wo du hinkommst, wenn du, Mann von edler Art,",
      "page": 36,
      "rid": "r933"
    },
    {
      "n": "670u6",
      "text": "Von mir dich abkehrst, meinen Zorn zu brechen suchst.",
      "page": 36,
      "rid": "r934"
    }
  ],
  "[895, 900]": [
    {
      "n": "895u1",
      "text": "Von Schrecken seh'n, der unsres Schiffes Steuer führt.",
      "page": 45,
      "rid": "r1218"
    },
    {
      "n": "895u2",
      "text": "Der Botr.",
      "page": 45,
      "rid": "r1220"
    },
    {
      "n": "895u3",
      "text": "Gewährtet ihr, o Freunde, wohl die Kunde mir,",
      "page": 45,
      "rid": "r1221"
    },
    {
      "n": "895u4",
      "text": "Wo seine Wohnung Dedipus, der König, hat?",
      "page": 45,
      "rid": "r1222"
    },
    {
      "n": "895u5",
      "text": "Doch, wisset ihr's, sagt lieber, wo er selber weilt.",
      "page": 45,
      "rid": "r1223"
    }
  ],
  "[1100, 1105]": [
    {
      "n": "1100u1",
      "text": "Das ist, o Herr, kein Wunder; doch ich will ihn klar",
      "page": 57,
      "rid": "r1565"
    },
    {
      "n": "1100u2",
      "text": "An Längstvergangnes mahnen. Denn ich weiß, er wird",
      "page": 57,
      "rid": "r1566"
    },
    {
      "n": "1100u3",
      "text": "Noch wissen, als wir auf Kithärons hoher Trift",
      "page": 57,
      "rid": "r1567"
    }
  ]
}