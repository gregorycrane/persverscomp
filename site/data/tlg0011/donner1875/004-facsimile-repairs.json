        "n": "1482",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 10,
        "text": "Was ich nicht erkannte, sprech' ich niemals blindlings aus,",
        "kind": "verse",
        "printed_n": null,
        "speech": 435,
        "speaker": "Kreon.",
        "shared_group": "1480-4",
        "part": "M",
        "rid": "r2072",
        "n": "1482",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 12,
        "text": "Nun, so führe mich von hinnen!",
        "kind": "verse",
        "printed_n": null,
        "speech": 436,
        "speaker": "Dedipus.",
        "shared_group": "1480-6",
        "part": "I",
        "rid": "r2074",
        "n": "1483",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 15,
        "text": "Geh und laß die Kinder hier.",
        "kind": "verse",
        "printed_n": null,
        "speech": 437,
        "speaker": "Kreon.",
        "shared_group": "1480-6",
        "part": "F",
        "rid": "r2077",
        "n": "1483",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 17,
        "text": "Nimmermehr entreiße die mir!",
        "kind": "verse",
        "printed_n": null,
        "speech": 438,
        "speaker": "Oedipus.",
        "shared_group": "1480-9",
        "part": "I",
        "rid": "r2079",
        "n": "1484",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 19,
        "text": "Ringe nicht nach jedem Sieg!",
        "kind": "verse",
        "printed_n": null,
        "speech": 439,
        "speaker": "Kreon.",
        "shared_group": "1480-9",
        "part": "F",
        "rid": "r2081",
        "n": "1484",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 20,
        "text": "Was du dir ersiegt, es folgte nicht getreu durch's Leben dir.",
        "kind": "verse",
        "printed_n": 1485,
        "speech": 439,
        "speaker": "Kreon.",
        "rid": "r2082",
        "anchor": 1485,
        "n": "1485",
        "number_basis": "printed anchor"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 22,
        "text": "Ihr Bewohner meiner Thebe, sehet, das ist Oedipus,",
        "kind": "verse",
        "printed_n": null,
        "speech": 440,
        "speaker": "Der Chor.",
        "rid": "r2084",
        "n": "1486",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 23,
        "text": "Der entwirrt die hohen Käthsel und der Erste war an Macht,",
        "kind": "verse",
        "printed_n": null,
        "speech": 440,
        "speaker": "Der Chor.",
        "rid": "r2085",
        "n": "1487",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 24,
        "text": "Dessen Glück die Bürger alle priesen und beneideten,",
        "kind": "verse",
        "printed_n": null,
        "speech": 440,
        "speaker": "Der Chor.",
        "rid": "r2086",
        "n": "1488",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 25,
        "text": "Seht, in welches Mißgeschickes grause Wogen er versank!",
        "kind": "verse",
        "printed_n": null,
        "speech": 440,
        "speaker": "Der Chor.",
        "rid": "r2087",
        "n": "1489",
        "number_basis": "interpolated between printed anchors"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 26,
        "text": "Drum der Erdensöhne keinen, welcher noch auf jenen Tag",
        "kind": "verse",
        "printed_n": 1490,
        "speech": 440,
        "speaker": "Der Chor.",
        "rid": "r2088",
        "anchor": 1490,
        "n": "1490",
        "number_basis": "printed anchor"
      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 27,
        "text": "Harrt, den lezten seiner Tage, preise du vorher beglückt,",
        "kind": "verse",
        "printed_n": null,
        "speech": 440,
        "speaker": "Der Chor.",
        "rid": "r2089",
