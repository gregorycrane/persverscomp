      },
      {
        "page": 73,
        "scan": 83,
        "ocr_line": 8,
        "text": "Meinst du?",
        "kind": "verse",
        "printed_n": null,
        "speech": 434,
        "speaker": "Oedipus.",
        "shared_group": "1480-4",
        "part": "I",
