  "[1255, 1260]": [
    {
      "n": "1255u1",
      "text": "Mein Weib, ach! entseelt,",
      "page": 251,
      "rid": "r1640"
    },
    {
      "n": "1255u2",
      "text": "Vom Sohn mitgerissen in graunvollen Tod?",
