{
  "[825, 830]": [
    {
      "n": "825u1",
      "text": "Ja.",
      "page": 39,
      "rid": "r1023"
    },
    {
      "n": "825u2",
      "text": "Ich weiß: dem betrübt harrenden kam",
      "page": 39,
      "rid": "r1025"
    },
    {
      "n": "825u3",
      "text": "Rächend ein Freund; aber für mich ist er dahin; der es mir war,",
      "page": 39,
      "rid": "r1026"
    },
    {
      "n": "825u4",
      "text": "Weg mir gerafft schied er!",
      "page": 39,
      "rid": "r1027"
    },
    {
      "n": "825u5",
      "text": "Schwer, ja schwer liegt auf dir das Leid.",
      "page": 40,
      "rid": "r1031"
    }
  ],
  "[995, 1000]": [
    {
      "n": "995u1",
      "text": "Wegwerfen würd'st du, was ich jezt wohlmeinend rieth.",
      "page": 46,
      "rid": "r1253"
    },
    {
      "n": "995u2",
      "text": "So muß mit eignen Händen ich allein die That",
      "page": 47,
      "rid": "r1255"
    },
    {
      "n": "995u3",
      "text": "Vollbringen; denn nicht unvollendet lass' ich sie.",
      "page": 47,
      "rid": "r1256"
    },
    {
      "n": "995u4",
      "text": "Weh!",
      "page": 47,
      "rid": "r1258"
    },
    {
      "n": "995u5",
      "text": "O daß du solches Sinnes, als der Vater starb,",
      "page": 47,
      "rid": "r1259"
    }
  ],
  "[1135, 1140]": [
    {
      "n": "1135u1",
      "text": "Weh, weh!",
      "page": 53,
      "rid": "r1458"
    },
    {
      "n": "1135u2",
      "text": "Auf Pfaden des Grau'ns",
      "page": 53,
      "rid": "r1459"
    },
    {
      "n": "1135u3",
      "text": "Gesendet, o mein Trauter, gabst du mir den Tod,",
      "page": 53,
      "rid": "r1461"
    }
  ],
  "[1195, 1200]": [
    {
      "n": "1195u1",
      "text": "Keine Lüge sag' ich dir.",
      "page": 57,
      "rid": "r1572"
    },
    {
      "n": "1195u2",
      "text": "So lebt Orestes?",
      "page": 57,
      "rid": "r1574"
    },
    {
      "n": "1195u3",
      "text": "Wenn ich selbst am Leben bin.",
      "page": 57,
      "rid": "r1576"
    },
    {
      "n": "1195u4",
      "text": "Du bist es selber?",
      "page": 57,
      "rid": "r1578"
    },
    {
      "n": "1195u5",
      "text": "Sieh des Vaters Siegel hier",
      "page": 57,
      "rid": "r1580"
    },
    {
      "n": "1195u6",
      "text": "An meiner Hand, zum Zeichen, daß ich Wahres sprach.",
      "page": 57,
      "rid": "r1581"
    },
    {
      "n": "1195u7",
      "text": "schönster Tag!",
      "page": 57,
      "rid": "r1583"
    },
    {
      "n": "1195u8",
      "text": "schönster also sag' auch ich!",
      "page": 57,
      "rid": "r1585"
    }
  ],
  "[1200, 1205]": [
    {
      "n": "1200u1",
      "text": "Stimme!",
      "page": 57,
      "rid": "r1588"
    },
    {
      "n": "1200u2",
      "text": "Hör' es nicht von Andern mehr!",
      "page": 57,
      "rid": "r1590"
    },
    {
      "n": "1200u3",
      "text": "Du bist in meinen Armen?",
      "page": 57,
      "rid": "r1592"
    },
    {
      "n": "1200u4",
      "text": "Bleib' es immer so!",
      "page": 57,
      "rid": "r1594"
    },
    {
      "n": "1200u5",
      "text": "Geliebte Frau'n, ihr Bürgerinnen dieser Stadt,",
      "page": 57,
      "rid": "r1596"
    },
    {
      "n": "1200u6",
      "text": "Seht hier Orestes, welcher erst durch schlaue List",
      "page": 57,
      "rid": "r1597"
    },
    {
      "n": "1200u7",
      "text": "Gestorben, nun durch schlaue List erhalten blieb!",
      "page": 57,
      "rid": "r1598"
    }
  ],
  "[1245, 1250]": [
    {
      "n": "1245u1",
      "text": "Naube mir doch nicht die Wonne,",
      "page": 60,
      "rid": "r1666"
    },
    {
      "n": "1245u2",
      "text": "An deinem Anblick, Trauter, mich zu weiden!",
      "page": 60,
      "rid": "r1667"
    },
    {
      "n": "1245u3",
      "text": "Selbst Andern zürnt' ich, gönnten sie dir solches nicht.",
      "page": 60,
      "rid": "r1669"
    },
    {
      "n": "1245u4",
      "text": "Du gönnst mir's?",
      "page": 60,
      "rid": "r1671"
    },
    {
      "n": "1245u4",
      "text": "Warum nicht?",
      "page": 60,
      "rid": "r1673"
    },
    {
      "n": "1245u5",
      "text": "Eben ward mir eine Kunde,",
      "page": 60,
      "rid": "r1675"
    }
  ],
  "[1460, 1465]": [
    {
      "n": "1460u1",
      "text": "Das deine sicher: ganz bestimmt weissag' ich dir's.",
      "page": 71,
      "rid": "r2019"
    },
    {
      "n": "1460u2",
      "text": "Nicht als ererbt vom Vater rühmst du diese Kunst.",
      "page": 71,
      "rid": "r2021"
    },
    {
      "n": "1460u3",
      "text": "Viel Gegenreden; doch der Gang verzögert sich!",
      "page": 71,
      "rid": "r2023"
    },
    {
      "n": "1460u4",
      "text": "Hinein!",
      "page": 71,
      "rid": "r2024"
    },
    {
      "n": "1460u5",
      "text": "Ich folge.",
      "page": 71,
      "rid": "r2025"
    },
    {
      "n": "1460u6",
      "text": "Nein, du selbst gehst mir voran!",
      "page": 71,
      "rid": "r2028"
    }
  ]
}