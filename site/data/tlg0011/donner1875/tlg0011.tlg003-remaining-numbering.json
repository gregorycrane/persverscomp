{
  "[405, 410]": [
    {
      "n": "405u1",
      "text": "Lieg' ich am Boden!",
      "page": 108,
      "rid": "r554"
    },
    {
      "n": "405u2",
      "text": "Nicht wehren kann ich deinem Wort, noch kann ich so",
      "page": 109,
      "rid": "r557"
    },
    {
      "n": "405u3",
      "text": "Dich reden lassen, da du ringst mit solcher Noth.",
      "page": 109,
      "rid": "r558"
    },
    {
      "n": "405u4",
      "text": "Ah, ah!",
      "page": 109,
      "rid": "r559"
    },
    {
      "n": "405u5",
      "text": "Wer konnte jemals ahnen, daß mein Name so",
      "page": 109,
      "rid": "r561"
    }
  ],
  "[570, 575]": [
    {
      "n": "570u1",
      "text": "Mahne den, der hören will!",
      "page": 115,
      "rid": "r758"
    },
    {
      "n": "570u2",
      "text": "Nicht folgen willst du?",
      "page": 115,
      "rid": "r760"
    },
    {
      "n": "570u3",
      "text": "Ich zitt're, König",
      "page": 115,
      "rid": "r762"
    },
    {
      "n": "570u4",
      "text": "Laß dich erbitten!",
      "page": 115,
      "rid": "r763"
    },
    {
      "n": "570u5",
      "text": "Viel zu viel schon schwazest du.",
      "page": 115,
      "rid": "r764"
    },
    {
      "n": "570u6",
      "text": "Eilig schließt die Thüre zu!",
      "page": 115,
      "rid": "r768"
    },
    {
      "n": "570u7",
      "text": "Aberwizig scheinst du mir,",
      "page": 115,
      "rid": "r771"
    },
    {
      "n": "570u8",
      "text": "Wofern du jezt noch meinen Sinn zu meistern deukst.",
      "page": 115,
      "rid": "r772"
    }
  ],
  "[935, 940]": [
    {
      "n": "935u1",
      "text": "Bei solchen Schrecken -",
      "page": 130,
      "rid": "r1243"
    },
    {
      "n": "935u2",
      "text": "Ach, ich Unglückseliger!",
      "page": 130,
      "rid": "r1245"
    },
    {
      "n": "935u3",
      "text": "Ziemt herbe Klage.",
      "page": 130,
      "rid": "r1247"
    },
    {
      "n": "935u4",
      "text": "Weh, verhängnißschweres Leid!",
      "page": 130,
      "rid": "r1249"
    },
    {
      "n": "935u5",
      "text": "Zu schwer, o Teukros!",
      "page": 131,
      "rid": "r1252"
    },
    {
      "n": "935u6",
      "text": "Wehe mir! Doch sagt mir an:",
      "page": 131,
      "rid": "r1254"
    },
    {
      "n": "935u7",
      "text": "Sein Knabe, wo weilt dieser mir im Troerland?",
      "page": 131,
      "rid": "r1255"
    }
  ]
}